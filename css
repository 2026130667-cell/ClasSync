/* =========================================================
   SF PRO & INTER SYSTEM TYPOGRAPHY & DESIGN TOKENS
   ========================================================= */
:root {
  --canvas-bg: #F8F5F5;
  --card-surface: #FFFFFF;
  --brand-primary: #96515D;
  --brand-hover: #7E3F4B;
  --text-main: #1C1917;
  --text-muted: #78716C;
  --border-subtle: rgba(150, 81, 93, 0.08);
}

html.dark {
  --canvas-bg: #121010;
  --card-surface: #1C191A;
  --text-main: #F5F5F4;
  --text-muted: #D6D3D1;
  --border-subtle: rgba(255, 255, 255, 0.08);
}

body {
  background-color: var(--canvas-bg);
  color: var(--text-main);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  letter-spacing: -0.01em;
  -webkit-font-smoothing: antialiased;
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* =========================================================
   WIDGET CARD STYLING & DEFINED SURFACES
   ========================================================= */
.glass-card {
  background-color: var(--card-surface) !important;
  border: 1.5px solid rgba(150, 81, 93, 0.2) !important;
  border-radius: 1.5rem !important;
  box-shadow: 0 10px 25px -5px rgba(150, 81, 93, 0.08), 
              0 4px 10px -2px rgba(0, 0, 0, 0.03) !important;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.2s ease !important;
}

html.dark .glass-card {
  background-color: #1C191A !important;
  border-color: rgba(255, 255, 255, 0.1) !important;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.45) !important;
}

.glass-card:hover {
  transform: translateY(-3px) !important;
  border-color: #96515D !important;
  box-shadow: 0 16px 32px -6px rgba(150, 81, 93, 0.18) !important;
}

/* =========================================================
   DARK MODE TEXT, INPUTS & SURFACE OVERRIDES
   ========================================================= */
html.dark #auth-screen {
  background-color: #121010 !important;
}

html.dark label,
html.dark .text-muted {
  color: #D6D3D1 !important;
}

html.dark .text-ink {
  color: #F5F5F4 !important;
}

html.dark .bg-white {
  background-color: #1C191A !important;
}

html.dark .bg-white\/70 {
  background-color: rgba(38, 34, 35, 0.7) !important;
}

html.dark .border-slate-100,
html.dark .border-slate-200 {
  border-color: rgba(255, 255, 255, 0.12) !important;
}

html.dark .hover\:bg-slate-50\/50:hover,
html.dark .hover\:bg-slate-50:hover {
  background-color: rgba(255, 255, 255, 0.06) !important;
}

html.dark input:not([type="checkbox"]):not([type="color"]),
html.dark select {
  background-color: #262223 !important;
  color: #F5F5F4 !important;
  border-color: rgba(255, 255, 255, 0.14) !important;
}

html.dark input::placeholder {
  color: #8C8582 !important;
}

/* Keep flip clock numbers bright white in both themes */
#flip-hours,
#flip-minutes {
  color: #FDF7F8 !important;
}

/* =========================================================
   TIMETABLE & SCROLLBARS
   ========================================================= */
.grid-cell-item {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.grid-cell-item:hover {
  transform: scale(1.02);
  box-shadow: 0 6px 16px rgba(150, 81, 93, 0.12);
}

::-webkit-scrollbar { 
  width: 6px; 
  height: 6px; 
}
::-webkit-scrollbar-track { 
  background: transparent; 
}
::-webkit-scrollbar-thumb { 
  background: #E7E5E4; 
  border-radius: 999px; 
}
html.dark ::-webkit-scrollbar-thumb {
  background: #3F3A3B;
}
::-webkit-scrollbar-thumb:hover { 
  background: #96515D; 
}

/* Control visibility of application screens */
#app-layout.hidden {
  display: none !important;
}

#app-layout:not(.hidden) {
  display: flex !important;
}

#auth-screen.hidden {
  display: none !important;
}

/* =========================================================
   TIMETABLE & SCROLLBARS
   ========================================================= */
.glass-card table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.glass-card table th:first-child,
.glass-card table td:first-child {
  width: 80px;
}

.glass-card table th:not(:first-child),
.glass-card table td:not(:first-child) {
  width: calc((100% - 80px) / 6);
  vertical-align: top;
  word-wrap: break-word;
}

/* Lock every hour row to 64px vertically */
#timetable-grid-body tr {
  height: 64px !important;
}

/* Anchor the spanned cell so the inner card can stretch from top to bottom */
#timetable-grid-body td[rowspan] {
  position: relative !important;
  padding: 0 !important;
}

/* Force the colored card to stretch the full vertical span of the cell */
#timetable-grid-body td[rowspan] > div {
  position: absolute !important;
  top: 4px !important;
  bottom: 4px !important;
  left: 4px !important;
  right: 4px !important;
  height: auto !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#timetable-grid-body td[rowspan] > div:hover {
  transform: scale(1.02);
  box-shadow: 0 6px 16px rgba(150, 81, 93, 0.12);
}

/* Mobile Bottom Navigation */
.mobile-nav-btn {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 8px 4px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
  color: #78716c;
  transition: all 0.2s ease;
  cursor: pointer;
}

.mobile-nav-btn i {
  font-size: 17px;
}

.mobile-nav-btn.active {
  color: #96515D;
  background: #FDF7F8;
}

html.dark .mobile-nav-btn {
  color: #D6D3D1;
}

html.dark .mobile-nav-btn.active {
  color: #F0B7C1;
  background: rgba(150, 81, 93, 0.2);
}
/* Dark mode mobile navigation */
html.dark .mobile-nav-btn {
  color: #A8A29E;
}

html.dark .mobile-nav-btn.active {
  color: #F5F5F4;
  background: rgba(150, 81, 93, 0.25);
}

@media (max-width: 767px) {
  main {
    padding-bottom: 100px !important;
  }

  #app-layout > nav {
    display: flex;
  }
}

